# Copy to .env and fill with real values using a secure secret manager.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=urban_danger_db
DB_SSL_CA=
DB_TLS=true
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,https://urbandanger.netlify.app,https://urban-danger-admin.netlify.app
FRONTEND_ORIGIN=https://urbandanger.netlify.app
ADMIN_FRONTEND_ORIGIN=https://urban-danger-admin.netlify.app
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN_SECRET=
JWT_SECRET=
# Route requests are made server-side. The public OpenStreetMap routing
# instances are community services with no availability guarantee; override
# these URLs with an approved provider for production use.
OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
OSRM_WALKING_BASE_URL=https://routing.openstreetmap.de/routed-foot/route/v1/driving
OSRM_BICYCLE_BASE_URL=https://routing.openstreetmap.de/routed-bike/route/v1/driving
ROUTE_MOTORCYCLE_ESTIMATED_SPEED_KMH=25
ROUTE_TRUCK_ESTIMATED_SPEED_KMH=20
# Optional; built-in allowlist defaults to the approved safe publishers.
# The default discovery set includes Google News RSS plus original publishers such
# as GMA, PNA, Philstar, and Manila Times when they remain within the strict
# provenance gate and allowlist.
TRUSTED_SOURCE_HOSTS=gmanetwork.com,news.google.com,pna.gov.ph,philstar.com,manilatimes.net,news.tv5.com.ph
# Optional; defaults to live discovery URLs for RSS and original-source pages.
# These are still subject to the same strict provenance / allowlist checks.
SOURCE_COLLECTION_TARGET_URLS=https://news.google.com/rss/search?q=Taguig+City+incident,https://news.google.com/rss/search?q=Pateros+incident,https://www.gmanetwork.com/news/,https://www.pna.gov.ph/,https://www.philstar.com/,https://www.manilatimes.net/
DEVELOPMENT_NLP_STUB=false
GEMINI_API_KEY=
GEMINI_MODEL=
INGESTION_INTERVAL_MINUTES=30
INTERNAL_INGEST_KEY=
SCHEDULED_INGEST_KEY=
ROUTE_INCIDENT_PROXIMITY_METERS=500
# Official PSA OpenSTAT PXWeb API endpoint for TABLE 17.1, matrix 1H2BRCI0.
# Source: https://openstat.psa.gov.ph/PXWeb/pxweb/en/DB/DB__3S__C17/
OPENSTAT_CRIME_API_URL=https://openstat.psa.gov.ph/PXWeb/api/v1/en/DB/DB__3S__C17/1H2BRCI0
